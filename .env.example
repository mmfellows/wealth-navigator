# --- Required in all environments ---
NODE_ENV=production
JWT_SECRET=<random-long-string>

# AES-256-CBC key as 32-byte hex (generate: `openssl rand -hex 32`)
# Required in production. Without it, cold starts would generate fresh keys
# and previously-stored Plaid access tokens become unrecoverable.
ENCRYPTION_KEY=<64-hex-chars>
# Optional, only during a key rotation: the incoming key. New writes use it and
# reads fall back to it. Procedure: set it, deploy, POST /api/internal/rotate-encryption-key,
# confirm with GET /api/internal/encryption-key-status, then move the value into
# ENCRYPTION_KEY, unset this, and deploy again. See backend/services/encryption.js.
# ENCRYPTION_KEY_NEXT=<64-hex-chars>

# Cron secret used to authenticate Vercel Cron calls to /api/internal/sync-all
CRON_SECRET=<random-long-string>

# --- Firebase Admin ---
# JSON-stringified service account. Paste the entire contents of serviceAccountKey.json
# as one line (escape inner quotes if pasting in a shell).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# --- Plaid ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
PLAID_USER_PHONE=
# Set after first deploy: https://<your-vercel-domain>/api/plaid/webhook
PLAID_WEBHOOK_URL=

# --- Optional ---
USE_YAHOO_FINANCE=true
ALPHA_VANTAGE_API_KEY=
IEX_CLOUD_TOKEN=
# Comma-separated list of allowed CORS origins for production. Leave blank to allow same-origin only.
CORS_ORIGINS=

# --- Google Sign-In (optional) ---
# OAuth 2.0 web client ID from Google Cloud Console. Set BOTH values to the
# same client ID: GOOGLE_CLIENT_ID is read by the backend to verify ID tokens,
# VITE_GOOGLE_CLIENT_ID is baked into the frontend at build time to render the
# button. Leave blank to hide Google sign-in.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
