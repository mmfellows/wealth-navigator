# --- Required in all environments ---
NODE_ENV=production
JWT_SECRET=<random-long-string>

# AES-256-CBC key as 32-byte hex (generate: `openssl rand -hex 32`)
# Required in production. Without it, cold starts would generate fresh keys
# and previously-stored Plaid access tokens become unrecoverable.
ENCRYPTION_KEY=<64-hex-chars>

# Cron secret used to authenticate Vercel Cron calls to /api/internal/sync-all
CRON_SECRET=<random-long-string>

# --- Firebase Admin ---
# JSON-stringified service account. Paste the entire contents of serviceAccountKey.json
# as one line (escape inner quotes if pasting in a shell).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# --- Plaid ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
PLAID_USER_PHONE=
# Set after first deploy: https://<your-vercel-domain>/api/plaid/webhook
PLAID_WEBHOOK_URL=

# --- Optional ---
USE_YAHOO_FINANCE=true
ALPHA_VANTAGE_API_KEY=
IEX_CLOUD_TOKEN=
# Comma-separated list of allowed CORS origins for production. Leave blank to allow same-origin only.
CORS_ORIGINS=
