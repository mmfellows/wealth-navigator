# Server Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# Registration allow-list (single-tenant policy).
# Comma-separated list of emails permitted to call POST /api/auth/register.
# In production, an empty list disables registration entirely (fail-closed).
# Example: REGISTRATION_ALLOWLIST=matt@tangiblevalue.com
REGISTRATION_ALLOWLIST=

# Demo-login switch. The /api/auth/demo endpoint is disabled in production by
# default. Set to "true" only if you intend to expose the demo account.
ALLOW_DEMO_LOGIN=false

# WebAuthn / passkey configuration. Required in production.
#   WEBAUTHN_RP_ID:    the host the browser sees (no scheme, no port).
#   WEBAUTHN_ORIGIN:   the full origin including scheme.
#   WEBAUTHN_RP_NAME:  display name shown in the OS/browser prompt.
# Production example: rp_id=wealth-navigator.vercel.app
#                     origin=https://wealth-navigator.vercel.app
# Local dev defaults: rp_id=localhost  origin=http://localhost:3000
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_NAME=Wealth Navigator

# Free Financial Data APIs (choose one)
# Alpha Vantage (free: 5 calls/min, 500 calls/day)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# IEX Cloud (generous free tier)
IEX_CLOUD_TOKEN=your_iex_token

# Yahoo Finance API (free but unofficial - no key needed)
USE_YAHOO_FINANCE=true

# AI Research Assistant (optional)
# OpenAI (pay per use)
OPENAI_API_KEY=your_openai_key

# Perplexity (has free tier)
PERPLEXITY_API_KEY=your_perplexity_key

# Plaid Configuration (for brokerage account connections)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret_key
PLAID_ENV=sandbox  # sandbox, development, or production
PLAID_REDIRECT_URI=http://localhost:3000/oauth-callback

# Brokerage APIs (when ready to connect)
ETRADE_CONSUMER_KEY=your_etrade_key
ETRADE_CONSUMER_SECRET=your_etrade_secret
SCHWAB_CLIENT_ID=your_schwab_id
SCHWAB_CLIENT_SECRET=your_schwab_secret
# AI research assistant (Anthropic Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: override the model (default claude-opus-4-8)
# ANTHROPIC_MODEL=claude-sonnet-5
